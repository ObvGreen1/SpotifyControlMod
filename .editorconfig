# EditorConfig - https://editorconfig.org
# Keeps formatting consistent regardless of editor/IDE.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{java,gradle}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
indent_size = 2

[*.{properties,toml}]
indent_size = 4
