# ---------------------------------------------------------------------------
# Mod runtime data that must never be committed
# ---------------------------------------------------------------------------
# Root-level only: the mod writes config/spotifycontrol.json here at runtime and
# that file can hold OAuth tokens. The src/**/client/config/ package is source
# code and must NOT be ignored, hence the leading slash.
/config/
/spotifycontrol.json
*.token
